# Keycloak control plane — configuration knobs.
#
# COPY, DO NOT EDIT IN PLACE:  cp .env.example .env   (`.env` is gitignored)
#
# `.env` is the OPERATOR's file: non-secret knobs, authored once, persistent.
# `.env.secrets` is RENDERED by bin/deploy.sh from OpenBao at deploy time and
# removed on exit. They are separate files on purpose — one file for both would
# mean the deploy truncating the operator's configuration (including the image
# digest it is about to check) on every run. Compose receives both.
#
# THIS FILE CONTAINS NO VALUES FOR ANY SECRET AND NEVER MAY -- and, since this
# repository is public, no OpenBao PATH either. A path is estate topology: it
# tells a reader exactly where the credentials sit. Each path is therefore a
# REQUIRED configuration input with no default, named here and supplied by the
# operator. bin/deploy.sh reads the material at deploy time and never echoes it;
# bin/check-no-secrets.sh fails the build if a literal appears anywhere in the
# tree. See docs/SECRETS.md.

# ---- image pins ------------------------------------------------------------
# KEYCLOAK_IMAGE_DIGEST is the real pin. The tag is a moving label; the digest
# is the artifact. bin/deploy.sh refuses to deploy with REQUIRE_IMAGE_DIGEST=true
# and an empty digest, so leaving it blank fails closed rather than quietly
# deploying whatever the tag points at today.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.0.7
KEYCLOAK_IMAGE_DIGEST=
KC_DB_IMAGE=postgres
KC_DB_VERSION=16
KC_DB_IMAGE_DIGEST=
REQUIRE_IMAGE_DIGEST=true

# ---- compose ---------------------------------------------------------------
KC_COMPOSE_PROJECT=keycloak
KC_COMPOSE_FILE=compose/docker-compose.yml
KC_SERVICE=keycloak
KC_DB_SERVICE=postgres

# ---- network ---------------------------------------------------------------
# Loopback only; nginx terminates TLS in front. A 0.0.0.0 bind would bypass ufw.
KC_HTTP_BIND=127.0.0.1
KC_HTTP_PORT=8080
KC_DB_BIND=127.0.0.1
KC_DB_PORT=5432
KC_HOSTNAME=https://idp.dotmac.io
KC_PROXY_HEADERS=xforwarded

# ---- realm -----------------------------------------------------------------
KC_REALM=dotmac
# PERMANENT. Changing this orphans every external_identity_bindings row.
KC_ISSUER=https://idp.dotmac.io/realms/dotmac
KC_INTERNAL_URL=http://localhost:8080
KC_ADMIN_REALM=master

# ---- OpenBao locations: REQUIRED inputs, never values, never defaults ------
# BAO_KEYCLOAK_PATH names the OpenBao KV location holding the Keycloak database
# and admin material. It has NO default on purpose: a default would put the
# location back into a public repository, and "everything by config" means the
# operator supplies it. bin/deploy.sh refuses to run while it is unset and says
# so, naming the operator's private runbook, which is where the location is
# recorded. Set it here or export it in the deploying shell.
BAO_KEYCLOAK_PATH=
#
# bin/deploy.sh reads these fields from that location at deploy time, renders
# them into $SECRET_ENV_FILE under umask 077, and removes that file on exit:
#
#     field db_name        -> KC_DB_NAME
#     field db_user        -> KC_DB_USER
#     field db_password    -> KC_DB_PASSWORD
#     field admin_user     -> KC_ADMIN_USER
#     field admin_password -> KC_ADMIN_PASSWORD
#
# Leave the five knobs below EMPTY. They exist so the contract is visible; the
# deploy fills them, and a literal here would fail bin/check-no-secrets.sh.
KC_DB_NAME=
KC_DB_USER=
KC_DB_PASSWORD=
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=

# Two further OpenBao locations exist and are read by NOTHING in this
# repository. They are named as knobs only so an operator knows they are
# accounted for; the locations themselves are in the private runbook.
#   BAO_WORKSPACE_OIDC_PATH  the dotmac-workspace relying-party client secret.
#                            Not managed from here: neither read nor written by
#                            any script in this repository.
#   BAO_IDP_HOST_PATH        IdP host access. Used by no script here.
BAO_WORKSPACE_OIDC_PATH=
BAO_IDP_HOST_PATH=

# ---- verifier --------------------------------------------------------------
VERIFY_DISCOVERY=true
VERIFY_ROLLOUT=true
