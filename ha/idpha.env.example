# Per-node PRIVATE values for the IdP HA scripts. Names and shapes only; every
# value below is a placeholder (RFC 5737 documentation ranges, example paths).
#
# The real file is root-owned mode 600, lives on the node, and is authored from
# the operator's private runbook. It is NEVER committed (this repository is
# public: no addresses, no host layout, no secret-file locations, no bucket or
# backup topology — AGENTS.md § 1). The scripts refuse a values file that is not
# root-owned mode 600.
#
# Format: plain shell assignments, no command substitution.

# ---- identity of this node -----------------------------------------------------
NODE_NAME=node-1
OVERLAY_ADDR=192.0.2.1            # this node, on the encrypted overlay
PEER_OVERLAY_1=192.0.2.2
PEER_OVERLAY_2=192.0.2.3
PEER_PUBLIC_1=198.51.100.2        # peers' public addresses (WireGuard transport only)
PEER_PUBLIC_2=198.51.100.3
VIP_ADDR=203.0.113.10             # the floating address (collector: vip_present)
# WG_IF=wg0  WG_PORT=51820  WG_UNIT=wg-quick@wg0.service  PRIMARY_NIC=eth0  SSH_PORT=22

# ---- layout and secret-file locations (no defaults on purpose) -------------------
HA_DIR=/srv/example/ha
BACKUP_ENV_FILE=/srv/example/backup.env        # root 600; carries the write-only store identity
METRICS_TOKEN_FILE=/srv/example/metrics.token  # root 600; bearer for the metrics endpoint
PROVIDER_CRED_FILE=/srv/example/provider.env          # optional: provider credential file (permissions check)

# ---- upgrade policy (H1.4): distinct per node, UTC, never 04:xx ---------------------
APT_UPGRADE_TIME=01:15:00

# ---- web tier -------------------------------------------------------------------
# KC_HOSTNAME=idp.dotmac.io   LINKS_HOSTNAME=links.dotmac.io   (defaults: the public names)
# IDP_CERT_DIR=/etc/ssl/idp   LINKS_CERT_DIR=/etc/ssl/links
LINKS_ROOT=/srv/example/links
GATE_ALLOW="198.51.100.77/32 198.51.100.78/32"     # who may reach the IdP while closed
METRICS_ALLOW="198.51.100.79/32"                   # the monitoring host only
CERT_FILES="idp=/etc/ssl/idp/fullchain.pem links=/etc/ssl/links/fullchain.pem"
# CACHE_SHA256=<sha256 of the reviewed cache-ispn.xml>

# ---- backup (H3) -----------------------------------------------------------------
BACKUP_MC_ALIAS=store
BACKUP_BUCKET=example-bucket
BACKUP_PREFIX=ha
BACKUP_AGE_RECIPIENT_FILE=/srv/example/recipient.age   # public recipient(s)
PGDUMP_FORMAT_ARGS="--no-owner --no-acl"   # MUST equal the single-host backup's flags

# ---- collector (H4) --------------------------------------------------------------
# KC_CLUSTER_SIZE_METRIC=   # Keycloak metric for the Infinispan view; confirm in H5.0
