[Unit]
Description=IdP HA weekly rolling maintenance of THIS node (switchover first, then upgrades and restarts)
After=network-online.target

[Service]
Type=oneshot
# Enabling the timer IS the operator's standing approval for this one class of
# action, so the per-run plan digest is waived here (and only here). The script
# still refuses unless the whole cluster is healthy, never touches a second node,
# switches the leader away before upgrading it, and never reboots (the reboot flag is not passed).
Environment=IDPHA_ALLOW_UNBOUND_APPLY=1
ExecStart=@@HA_DIR@@/bin/idpha-rolling-maint.sh --params @@PARAMS_FILE@@ --apply
TimeoutStartSec=3600
