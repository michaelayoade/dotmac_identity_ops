{
  "clientId": "io.dotmac.field",
  "name": "Dotmac Field (native, pre-rollout)",
  "description": "Public native OIDC client for Dotmac Field. Disabled until verified App/Universal Links and the Sub token-exchange gate are complete (ADR-0069 sections 3 and 7). No redirects are registered before rollout.",
  "protocol": "openid-connect",
  "enabled": false,
  "publicClient": true,
  "bearerOnly": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "authorizationServicesEnabled": false,
  "fullScopeAllowed": false,
  "redirectUris": [],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "id.token.signed.response.alg": "RS256",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false",
    "post.logout.redirect.uris": ""
  }
}
