{
  "clientId": "dotmac-workspace",
  "name": "Dotmac Workspace",
  "description": "Confidential server-side OIDC client for Dotmac Workspace. Uses Authorization Code with S256 PKCE, server-held state and cookies. Its secret is managed outside this repository.",
  "protocol": "openid-connect",
  "enabled": true,
  "publicClient": false,
  "bearerOnly": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": false,
  "redirectUris": [
    "https://workspace.dotmac.io/login/callback"
  ],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "id.token.signed.response.alg": "RS256",
    "post.logout.redirect.uris": ""
  }
}
